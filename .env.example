# ==================================================
# RAAZ Publishing Platform - Backend Environment Config
# ==================================================

# Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/raaz_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_strong_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_key

# Super Admin Provisioning (Used with `npm run provision:superadmin`)
SUPERADMIN_USERNAME=raazadmin
SUPERADMIN_PASSWORD=SetAStrongPassword2026!
SUPERADMIN_PHONE=+919876543210

# Cloudinary Storage for Image Uploads (Optional - Falls back to local /uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Allowed Origins
CORS_ORIGIN=*
